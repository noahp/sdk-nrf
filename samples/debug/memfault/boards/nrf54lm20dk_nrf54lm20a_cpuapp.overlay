// You can also use the buttons in the sidebar to perform actions on nodes.
// Actions currently available include:

// * Enabling / disabling the node
// * Adding the bus to a bus
// * Removing the node
// * Connecting ADC channels

// For more help, browse the DeviceTree documentation at https://docs.zephyrproject.org/latest/guides/dts/index.html
// You can also visit the nRF DeviceTree extension documentation at https://docs.nordicsemi.com/bundle/nrf-connect-vscode/page/guides/ncs_configure_app.html#devicetree-support-in-the-extension
&gpio0 {
    status = "okay";
};
&gpio1 {
    status = "okay";
};

&gpio2 {
    status = "okay";
};
&gpio3 {
    status = "okay";
};


&pinctrl {
    /omit-if-no-ref/ uart20_default: uart20_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 16)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 17)>;
			bias-pull-up;
		};
	};

	/omit-if-no-ref/ uart20_sleep: uart20_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 16)>,
				<NRF_PSEL(UART_RX, 1, 17)>;
			low-power-enable;
		};
	};
};


&uart20 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart20_default>;
    pinctrl-1 = <&uart20_sleep>;
    pinctrl-names = "default", "sleep";

};


/ {
    aliases {
        wifi-spi = &spi22;
    };
};


&pinctrl {
    spi22_default: spi22_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 27)>,
                    <NRF_PSEL(SPIM_MISO, 1, 31)>,
                    <NRF_PSEL(SPIM_SCK, 1, 26)>;
        };
    };

    spi22_sleep: spi22_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 27)>,
                    <NRF_PSEL(SPIM_MISO, 1, 31)>,
                    <NRF_PSEL(SPIM_SCK, 1, 26)>;
            low-power-enable;
        };
    };
};

//Add Cmake -DSHIELD=nrf7002eb2
&spi22 {
    status = "okay";
    pinctrl-0 = <&spi22_default>;
    pinctrl-1 = <&spi22_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio1 6 GPIO_ACTIVE_LOW>;

    nrf70: nrf7002-spi@0 {
        compatible = "nordic,nrf7002-spi";
        reg = <0>;
        spi-max-frequency = <8000000>;

        wifi-max-tx-pwr-2g-dsss = <0x15>;
        wifi-max-tx-pwr-2g-mcs0 = <0x10>;
        wifi-max-tx-pwr-2g-mcs7 = <0x10>;
        wifi-max-tx-pwr-5g-low-mcs0 = <0x0D>;
        wifi-max-tx-pwr-5g-low-mcs7 = <0x0D>;
        wifi-max-tx-pwr-5g-mid-mcs0 = <0x0D>;
        wifi-max-tx-pwr-5g-mid-mcs7 = <0x0D>;
        wifi-max-tx-pwr-5g-high-mcs0 = <0x0C>;
        wifi-max-tx-pwr-5g-high-mcs7 = <0x0C>;

        host-irq-gpios   = <&gpio1 30 GPIO_ACTIVE_HIGH>;
        bucken-gpios     = <&gpio1 12 GPIO_ACTIVE_HIGH>;
        iovdd-ctrl-gpios = <&gpio1 10 GPIO_ACTIVE_HIGH>;
        label = "nrf7002";
        wlan0: wlan0 {
			compatible = "nordic,wlan";
		};
    };
};
&led0{
	gpios = <&gpio3 7 GPIO_ACTIVE_LOW>;
	label = "BM20C_LED 1";
};
&led1{
	gpios = <&gpio3 6 GPIO_ACTIVE_LOW>;
	label = "BM20C_LED 2";
};
&led2{
	gpios = <&gpio1 28 GPIO_ACTIVE_LOW>;
	label = "BM20C_LED 1";
};
&led3{
	gpios = <&gpio1 22 GPIO_ACTIVE_LOW>;
	label = "BM20C_LED 4";
};

&button0 {
	gpios = <&gpio2 7 GPIO_ACTIVE_LOW>;
	label = "BM20C_But 0";
};
&button1 {
	gpios = <&gpio0 7 GPIO_ACTIVE_LOW>;
	label = "BM20C_But 0";
};
&button2 {
	gpios = <&gpio1 8 GPIO_ACTIVE_LOW>;
	label = "BM20C_But 0";
};
&pwm20 {
   	status="disabled";
};
&spi00 {
   	status="disabled";
};
